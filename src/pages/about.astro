---
import Layout from '../layouts/Layout.astro';

const pageTitle = "About Me";

// My Information
const identity = {
    firstName: "SUPKORN",
    country: "Thailand",
    occupation: "Data Analytic Engineer",
    hobbies: ["playing guitar", "coding", "reading a book"]
};

const skills = ["HTML", "JavaScript", "Python", "Apps Script", "VBA"];

// What To Show
const happy = true;
const finished = false;
const goal = 5;
---

<Layout title={pageTitle}>
    <h1>{pageTitle}</h1>
    <p>Hello, my name is Mean. You can call me {identity.firstName}. I am learning building my blog using Astro!</p>
    
    <p>My Information :</p>
    <ul>
        <li>I live in {identity.country} for most time of my life.</li>
        {identity.hobbies.length >=2 &&
            <li>Two of my hobbies are: {identity.hobbies[0]} and {identity.hobbies[1]}.</li>
        }
    </ul>

    <p>My Skills :</p>
    <ul>
        {skills.map((skill) => <li>{skill}</li>)}
    </ul>

    <p>Conditional Rendering :</p>
    {happy && <p>I am happy to be learning Astro!</p>}
    {finished && <p>I finished the second chapter of Astro Docs!</p>}
    {goal <= 3 ? <p>I will finish chapter two within 3 days.</p> : <p>OMG. It takes time more than I think.🎃</p>}
    
</Layout>